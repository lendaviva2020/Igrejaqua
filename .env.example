# Públicas (podem ir ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública do app usada em TODOS os links que saem do sistema (convites, link da igreja, e-mails,
# login com Google, webhook do Pix). Local: http://localhost:3000. Na Vercel: o domínio definitivo
# (ex.: https://igrejaqua.vercel.app ou o domínio próprio). Se faltar na Vercel, o app usa o domínio
# de produção da própria Vercel; localhost configurado por engano na Vercel é ignorado (src/lib/app-url.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: tem prioridade sobre NEXT_PUBLIC_SITE_URL se você usar um domínio só para o app.
NEXT_PUBLIC_APP_URL=

# SOMENTE SERVIDOR — nunca prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# IA (opcional; desligada por padrão). Sem chave E modelo, nenhuma sugestão é possível. O modelo vem daqui (nome não verificado no Gate).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
CRON_SECRET=

# Contribuições: o dinheiro vai SEMPRE para a conta de cada igreja.
# Fase 1 (sem variável): cada igreja cadastra a própria chave Pix em Configurações > Contribuições.
# Fase 2 (opcional): aplicativo do IGREJAQUA no Mercado Pago para cada igreja conectar a PRÓPRIA conta (OAuth).
#   Mercado Pago Developers > Suas integrações > Criar aplicação (pagamentos online, Pix).
#   Redirect URL: https://<seu-dominio>/api/payments/mercadopago/callback
#   Webhooks: https://<seu-dominio>/api/webhooks/mercadopago (evento Pagamentos) > copiar a assinatura secreta.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
# Chave que cifra os tokens das igrejas no banco: openssl rand -base64 32  (guarde fora do banco)
MERCADOPAGO_TOKEN_KEY=

# Identidade pública (opcionais; nada aparece na landing enquanto estiverem vazias)
NEXT_PUBLIC_CHURCH_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_WHATSAPP=
# "true" só depois de habilitar o provedor Google no Supabase Auth
NEXT_PUBLIC_AUTH_GOOGLE=false

# --- Entrega de notificações (opcional; sem estas chaves o canal fica desligado e nada é enviado) ---
# E-mail transacional via Resend (RESEND_API_KEY é segredo: só servidor)
RESEND_API_KEY=
EMAIL_FROM=
# Web Push (gere o par com: npx web-push generate-vapid-keys). A pública vai ao navegador; a privada é segredo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@suaigreja.org
